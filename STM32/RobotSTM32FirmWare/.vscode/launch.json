        "${workspaceFolder}/.vscode/openocd"
      ],
      "configFiles": [
        "interface/stlink-dap.cfg",
        "robotstm32_h743.cfg"
      ],
      "svdFile": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.1.0.202306151215/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32H743.svd",
      "openOCDPreConfigLaunchCommands": [
        "adapter speed 3300"
      ],
      "overrideResetCommands": [
