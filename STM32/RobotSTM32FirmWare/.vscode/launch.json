{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RobotSTM32: Debug (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/Debug/RobotSTM32FirmWare.elf",
      "preLaunchTask": "Prepare Debug",
      "servertype": "stlink",
      "device": "STM32H743VITx",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "gdbPath": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.11.3.rel1.win32_1.1.0.202305231506/tools/bin/arm-none-eabi-gdb.exe",
