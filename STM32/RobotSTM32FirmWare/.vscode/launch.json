    },
    {
      "name": "RobotSTM32: Debug (OpenOCD, no RTOS)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/Debug/RobotSTM32FirmWare.elf",
      "preLaunchTask": "Prepare Debug",
      "servertype": "openocd",
      "device": "STM32H743VITx",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "liveGdbServerOutput": true,
      "gdbPath": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.11.3.rel1.win32_1.1.0.202305231506/tools/bin/arm-none-eabi-gdb.exe",
      "serverpath": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.3.0.202305091550/tools/bin/openocd.exe",
      "searchDir": [
        "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.1.0.202306221132/resources/openocd/st_scripts",
        "${workspaceFolder}/.vscode/openocd"
      ],
      "configFiles": [
        "interface/stlink-dap.cfg",
        "robotstm32_h743.cfg"
      ],
      "svdFile": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.1.0.202306151215/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32H743.svd",
      "openOCDPreConfigLaunchCommands": [
        "adapter speed 3300"
      ],
      "overrideResetCommands": [
        "monitor halt"
      ],
      "postLaunchCommands": [
        "thread 1"
      ],
      "postResetCommands": [
        "thread 1"
      ]
    },
    {
      "name": "RobotSTM32: Debug (OpenOCD + FreeRTOS)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/Debug/RobotSTM32FirmWare.elf",
      "preLaunchTask": "Prepare Debug",
      "servertype": "openocd",
      "device": "STM32H743VITx",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "liveGdbServerOutput": true,
      "gdbPath": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.11.3.rel1.win32_1.1.0.202305231506/tools/bin/arm-none-eabi-gdb.exe",
      "serverpath": "C:/ST/STM32CubeIDE_1.13.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.3.0.202305091550/tools/bin/openocd.exe",
      "searchDir": [
