      ],
      "postLaunchCommands": [
        "symbol-file ${workspaceFolder}/Debug/RobotSTM32FirmWare.elf",
        "monitor stm32h7x.cm7 configure -rtos FreeRTOS",
        "thread 1"
      ],
      "postResetCommands": [
        "symbol-file ${workspaceFolder}/Debug/RobotSTM32FirmWare.elf",
        "monitor stm32h7x.cm7 configure -rtos FreeRTOS",
        "thread 1"
      ]
    }
  ]
