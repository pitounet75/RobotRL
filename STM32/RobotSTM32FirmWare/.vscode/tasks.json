{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kill Debug Servers",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name 'ST-LINK_gdbserver','openocd' -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 500"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "make",
      "args": ["-j16", "all"],
      "options": {
        "cwd": "${workspaceFolder}/Debug"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Prepare Debug",
      "dependsOn": [
        "Kill Debug Servers",
        "Build Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
